# ~/.config/ghostty/config

# ── Theme ──────────────────────────────────────────────────────────
theme = Catppuccin Mocha

# ── Font ───────────────────────────────────────────────────────────
# JetBrains Mono is embedded in Ghostty; icons come from the embedded
# "Symbols Nerd Font" fallback, so Nerd Font glyphs work with no install.
font-family = JetBrains Mono
font-size = 13
font-thicken = true
adjust-cell-height = 12%

# ── Window ─────────────────────────────────────────────────────────
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-theme = ghostty
macos-titlebar-style = transparent
window-height = 28
window-width = 100

# ── Depth ──────────────────────────────────────────────────────────
background-opacity = 0.94
background-blur = 20
unfocused-split-opacity = 0.85

# ── Cursor ─────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
# Ghostty's zsh shell integration otherwise sets a blinking bar on
# zle-line-init, overriding cursor-style above.
shell-integration-features = no-cursor
mouse-hide-while-typing = true

# ── Behaviour ──────────────────────────────────────────────────────
scrollback-limit = 100000
copy-on-select = clipboard
confirm-close-surface = false
macos-option-as-alt = true
clipboard-paste-protection = true

# ── Keybinds ───────────────────────────────────────────────────────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+k=clear_screen
